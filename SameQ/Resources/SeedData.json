    {
      "id": "prompt_002",
      "text": "最近、誰かに言われてうれしかった一言は何ですか？",
      "promptLanguage": "ja",
      "posts": [
        {
          "id": "A7BE2A5F-5F1D-4A6A-B67A-BF87A07FBB0B",
